---
import { useT, path } from '../i18n/index.js';
import { getSite } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const email = (await getSite()).company.email || 'contact@maison-archam.fr';
---
<footer class="ft">
  <div class="ft-in">
    <div class="ft-top">
      <div class="ft-brand">
        <a class="ft-logo" href={path(lang, 'home')}>MAISON ARCHAM</a>
        <p>{t('ft.tagline')}</p>
        <a class="ft-nl" href={path(lang, 'newsletter')}>{t('ft.subscribe')}</a>
      </div>
      <div class="ft-cols">
        <nav aria-label={t('ft.house')}><h2>{t('ft.house')}</h2><a href={path(lang, 'parfum')}>{t('nav.parfum')}</a><a href={path(lang, 'journal')}>{t('nav.journal')}</a><a href={path(lang, 'maison')}>{t('ft.story')}</a><a href={path(lang, 'newsletter')}>{t('nav.newsletter')}</a></nav>
        <nav aria-label={t('ft.service')}><h2>{t('ft.service')}</h2><a href={path(lang, 'connexion')}>{t('nav.account')}</a><a href={path(lang, 'compte')}>{t('ft.track')}</a><a href={`${path(lang, 'aide')}#livraison`}>{t('ft.shipping')}</a><a href={`${path(lang, 'aide')}#contact`}>{t('nav.contact')}</a></nav>
        <div><h2>{t('nav.contact')}</h2><a href={`mailto:${email}`}>{email}</a><span set:html={t('ft.hours')}></span></div>
      </div>
    </div>
    <div class="ft-bottom">
      <div class="ft-soc">
        <a href="#" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4" stroke="currentColor" stroke-width="1.1"/><circle cx="9" cy="9" r="3.2" stroke="currentColor" stroke-width="1.1"/><circle cx="13.2" cy="4.8" r=".7" fill="currentColor"/></svg></a>
        <a href="#" aria-label="Pinterest"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.1"/><path d="M8 16l1.6-7.2M7 9.4c-.6-2.4 1-4 2.8-4 1.9 0 2.8 1.4 2.4 3.2-.4 1.6-1.6 2.4-2.6 2" stroke="currentColor" stroke-width="1.1"/></svg></a>
        <a href="#" aria-label="TikTok"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M10.5 2v9.5a2.8 2.8 0 11-2.8-2.8M10.5 2c.4 2 1.8 3.4 4 3.6" stroke="currentColor" stroke-width="1.1"/></svg></a>
      </div>
      <nav class="ft-legal" aria-label={t('ft.legal')}>
        <a href={`${path(lang, 'aide')}#livraison`}>{t('ft.shipping')}</a><a href={path(lang, 'cgv')}>{t('ft.terms')}</a><a href={path(lang, 'confidentialite')}>{t('ft.privacy')}</a><a href={path(lang, 'mentions')}>{t('ft.notice')}</a>
      </nav>
      <p class="ft-copy">© {new Date().getFullYear()} Maison Archam</p>
    </div>
  </div>
</footer>
