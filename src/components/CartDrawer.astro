---
import { useT, path } from '../i18n/index.js';
import { getMainProduct, loc } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const main = await getMainProduct();
---
<div class="cd" data-cart-drawer hidden>
  <button class="cd-overlay" type="button" aria-label={t('cart.close')} data-cart-close tabindex="-1"></button>
  <aside class="cd-panel" role="dialog" aria-modal="true" aria-labelledby="cd-title">
    <div class="cd-head">
      <p class="eyebrow" id="cd-title">{t('cart.title')} (<span data-cart-qty>0</span>)</p>
      <button class="hd-ico" type="button" aria-label={t('common.close')} data-cart-close><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.2"/></svg></button>
    </div>
    <div class="cd-empty" data-cart-empty>
      <p class="serif cd-empty-t">{t('cart.emptyDrawer')}</p>
      <a class="link-ed" href={path(lang, 'parfum')}>{t('cart.discover', { name: loc(main, 'name', lang) })}</a>
    </div>
    <div class="cd-filled" data-cart-filled hidden>
      <ul class="cd-lines" data-cart-lines></ul>
      <div class="cd-foot">
        <div class="cd-row"><span>{t('cart.subtotal')}</span><span data-cart-subtotal></span></div>
        <div class="cd-row muted cd-small"><span>{t('cart.shipping')}</span><span>{t('cart.free')}</span></div>
        <a class="btn" href={path(lang, 'commande')}>{t('cart.checkout')}</a>
        <a class="btn ghost" href={path(lang, 'panier')}>{t('cart.view')}</a>
      </div>
    </div>
  </aside>
</div>
<div class="toast" role="status" aria-live="polite" data-toast hidden></div>
<template id="tpl-cart-line">
  <li class="cd-line">
    <div class="cd-thumb"><img alt="" width="104" height="130" data-l-img></div>
    <div class="cd-info">
      <p class="serif cd-name" data-l-name></p>
      <p class="muted cd-variant" data-l-variant></p>
      <div class="cd-qrow">
        <div class="qty"><button class="qbtn" type="button" data-l-dec>−</button><span class="qval" data-l-qty aria-live="polite"></span><button class="qbtn" type="button" data-l-inc>+</button></div>
        <span data-l-total></span>
      </div>
      <button class="txt-btn cd-remove" type="button" data-l-remove>{t('cart.remove')}</button>
    </div>
  </li>
</template>
