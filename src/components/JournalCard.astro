---
import Img from './Img.astro';
import { path, fmtDate } from '../i18n/index.js';
import { loc, rich } from '../lib/data.js';
interface Props { lang: 'fr' | 'en'; a: any; variant?: 'home' | 'list' | 'related'; index?: number }
const { lang, a, variant = 'home', index = 0 } = Astro.props;
const title = loc(a, 'title', lang);
const cat = loc(a, 'category', lang);
const ratio = variant === 'related' ? ' r32' : variant === 'list' && index % 3 === 1 ? ' r34' : '';
---
<a class="j-card reveal" href={path(lang, 'journal', a.slug)} data-cat={cat}>
  <div class={`j-img zoom${ratio}`}><Img src={a.image} sizes="(max-width: 700px) 100vw, 33vw" widths={[400, 700, 1000]} /></div>
  <p class="eyebrow muted">{cat}{variant !== 'related' && ` ${variant === 'home' ? '—' : '·'} ${fmtDate(lang, a.date)}`}</p>
  {variant === 'list' ? <h3 class="j-title" set:html={rich(title)} /> : <p class="j-title" set:html={rich(title)} />}
  {variant === 'list' && <p class="j-excerpt">{loc(a, 'excerpt', lang)}</p>}
</a>
