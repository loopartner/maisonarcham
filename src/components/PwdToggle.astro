---
interface Props { id: string; label: string }
const { id, label } = Astro.props;
---
<button class="pwd-toggle" type="button" data-pwd-toggle aria-controls={id} aria-pressed="false" aria-label={label}><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6S1.5 10 1.5 10z" stroke="currentColor" stroke-width="1.1"/><circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.1"/></svg></button>
