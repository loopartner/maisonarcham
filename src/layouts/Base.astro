---
// Gabarit HTML commun à toutes les pages (site, commande, administration).
import { useT, path, ROUTES, LOCALES, clientStrings } from '../i18n/index.js';
import { asset } from '../lib/asset-hash.js';
import { getProducts, getSite, variantOf, loc } from '../lib/data.js';

interface Props { lang: 'fr' | 'en'; title?: string; description?: string; route?: string; slug?: string; alternates?: Record<string, string>; noindex?: boolean; scripts?: string[]; bodyClass?: string; cart?: boolean }
const { lang, title, description, route, slug, alternates, noindex = false, scripts = [], bodyClass, cart = true } = Astro.props;
const t = useT(lang);
const site = await getSite();
const pageTitle = title ? `${title} | Maison Archam` : (lang === 'en' ? t('seo.title') : site.seoTitle || t('seo.title'));
const desc = description || (lang === 'en' ? t('seo.description') : site.seoDescription || t('seo.description'));
const alt = alternates || (route ? Object.fromEntries(LOCALES.map((l) => [l, path(l, route, slug)])) : {});
const base = (Astro.site?.toString() || '').replace(/\/$/, '');
const products = await getProducts();
const catalogue = { maxQty: 10, products: Object.fromEntries(products.map((p) => [p.id, { name: loc(p, 'name', lang), variant: variantOf(lang === 'en' ? { ...p, kind: p.kindEn || 'Extrait de parfum' } : p), price: p.price, image: (p.images || [])[0] || '' }])) };
const json = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
const allScripts = ['/assets/js/site.js', ...(cart ? ['/assets/js/cart.js'] : []), ...scripts.map((s) => `/assets/js/${s}`)];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={desc}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<meta name="theme-color" content="#F8F6F2">
{Object.entries(alt).map(([l, href]) => <link rel="alternate" hreflang={l} href={`${base}${href}`}>)}
{alt.fr && <link rel="alternate" hreflang="x-default" href={`${base}${alt.fr}`}>}
{alt[lang] && <link rel="canonical" href={`${base}${alt[lang]}`}>}
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={desc}>
<meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'fr_FR'}>
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/cormorantgaramond-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={asset('/assets/css/fonts.css')}>
<link rel="stylesheet" href={asset('/assets/css/site.css')}>
<script type="application/json" id="ma-catalogue" set:html={json(catalogue)}></script>
<script type="application/json" id="ma-i18n" set:html={json({ lang, routes: Object.fromEntries(Object.entries(ROUTES).map(([k, v]) => [k, v[lang]])), t: clientStrings(lang) })}></script>
{allScripts.map((s) => <script is:inline src={asset(s)} defer></script>)}
</head>
<body class={bodyClass}>
<slot />
</body>
</html>
