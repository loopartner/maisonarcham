---
import Admin from '../../layouts/Admin.astro';
---
<Admin title={"Paramètres"} active="parametres" scripts={["admin.js", "admin-parametres.js"]}>
<header class="adm-head"><div><p class="eyebrow muted">Configuration</p><h1 class="adm-h1">Paramètres</h1></div></header>
<div data-publish-bar hidden></div>
<div class="adm-2col">
  <form class="panel adm-stack" data-company novalidate>
    <h2 class="adm-h2">Informations de la maison</h2>
    <p class="adm-muted">Utilisées dans les mentions légales, le pied de page et les e-mails.</p>
    <label class="field">Raison sociale<input class="in" name="name" maxlength="120"><span class="field-err" data-fe="name" hidden></span></label>
    <div class="acct-grid">
      <label class="field">SIRET<input class="in" name="siret" inputmode="numeric" maxlength="20"><span class="field-err" data-fe="siret" hidden></span></label>
      <label class="field">TVA intracommunautaire<input class="in" name="vat" maxlength="20"><span class="field-err" data-fe="vat" hidden></span></label>
      <label class="field">E-mail de contact<input class="in" name="email" type="email" maxlength="254"><span class="field-err" data-fe="email" hidden></span></label>
      <label class="field">Téléphone<input class="in" name="phone" type="tel" maxlength="30"><span class="field-err" data-fe="phone" hidden></span></label>
    </div>
    <label class="field">Adresse du siège<input class="in" name="address" maxlength="250"></label>
    <div class="acct-actions"><button class="adm-btn primary" type="submit">Enregistrer</button><span class="adm-flash" role="status" data-flash hidden></span></div>
  </form>
  <div class="adm-stack">
    <form class="panel adm-stack" data-site novalidate>
      <h2 class="adm-h2">Paramètres du site</h2>
      <label class="field">Titre du site (référencement)<input class="in" name="seoTitle" maxlength="70"><span class="field-err" data-fe="seoTitle" hidden></span></label>
      <label class="field">Description (référencement)<textarea class="in adm-textarea adm-textarea-s" name="seoDescription" rows="2" maxlength="160"></textarea></label>
      <p class="adm-muted">Langue : français · Devise : euro (€)</p>
      <div class="acct-actions"><button class="adm-btn primary" type="submit">Enregistrer</button><span class="adm-flash" role="status" data-flash hidden></span></div>
    </form>
    <section class="panel adm-stack">
      <h2 class="adm-h2">Paiement &amp; services</h2>
      <dl class="svc" data-services></dl>
    </section>
  </div>
</div>
<div class="adm-2col">
  <form class="panel adm-stack" data-shipping novalidate>
    <h2 class="adm-h2">Paramètres de livraison</h2>
    <div data-ship-rows class="adm-stack"></div>
    <p class="field-err" data-fe="shipping" hidden></p>
    <div class="acct-actions"><button class="adm-btn primary" type="submit">Enregistrer</button><span class="adm-flash" role="status" data-flash hidden></span></div>
  </form>
  <section class="panel adm-stack">
    <h2 class="adm-h2">Codes promotionnels</h2>
    <div class="adm-table-wrap"><table class="adm-table"><thead><tr><th scope="col">Code</th><th scope="col">Remise</th><th scope="col">Conditions</th><th scope="col">Utilisations</th><th scope="col">Statut</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody data-promos></tbody></table></div>
    <form class="adm-stack promo-form" data-promo-form novalidate>
      <h3 class="adm-h2" data-promo-title>Nouveau code</h3>
      <div class="acct-grid">
        <label class="field">Code<input class="in" name="code" maxlength="32" autocapitalize="characters"><span class="field-err" data-fe="code" hidden></span></label>
        <label class="field">Type<select class="in" name="type"><option value="percent">Pourcentage</option><option value="amount">Montant (€)</option></select></label>
        <label class="field">Valeur<input class="in" name="value" inputmode="decimal"><span class="field-err" data-fe="value" hidden></span></label>
        <label class="field">Minimum d’achat (€)<input class="in" name="minSubtotal" inputmode="decimal"><span class="field-err" data-fe="minSubtotal" hidden></span></label>
        <label class="field">Expire le<input class="in" type="date" name="expiresAt"><span class="field-err" data-fe="expiresAt" hidden></span></label>
        <label class="field">Utilisations max.<input class="in" name="maxUses" inputmode="numeric"><span class="field-err" data-fe="maxUses" hidden></span></label>
      </div>
      <label class="check"><input type="checkbox" name="active" checked><span>Actif</span></label>
      <div class="acct-actions"><button class="adm-btn primary" type="submit">Enregistrer le code</button><button class="txt-btn" type="button" data-promo-reset hidden>Annuler la modification</button><span class="adm-flash" role="status" data-flash hidden></span></div>
    </form>
  </section>
</div>
<div class="adm-2col" data-team-wrap>
  <section class="panel adm-stack">
    <h2 class="adm-h2">Administrateurs</h2>
    <div class="adm-table-wrap"><table class="adm-table"><thead><tr><th scope="col">Nom</th><th scope="col">E-mail</th><th scope="col">Rôle</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody data-team></tbody></table></div>
    <form class="adm-stack" data-invite novalidate>
      <h3 class="adm-h2">+ Inviter</h3>
      <p class="adm-muted">La personne doit avoir créé son compte sur le site et confirmé son adresse e-mail.</p>
      <div class="acct-grid">
        <label class="field">E-mail du compte<input class="in" name="email" type="email" maxlength="254"><span class="field-err" data-fe="email" hidden></span></label>
        <label class="field">Rôle<select class="in" name="role" data-roles></select><span class="field-err" data-fe="role" hidden></span></label>
      </div>
      <div class="acct-actions"><button class="adm-btn primary" type="submit">Donner l’accès</button><span class="adm-flash" role="status" data-flash hidden></span></div>
    </form>
  </section>
  <div class="adm-stack">
    <form class="panel adm-stack" data-notif novalidate>
      <h2 class="adm-h2">Notifications</h2>
      <label class="check"><input type="checkbox" name="newOrder"><span>E-mail à chaque nouvelle commande</span></label>
      <label class="check"><input type="checkbox" name="lowStock"><span>Alerte quand un stock passe sous son seuil</span></label>
      <div class="acct-actions"><button class="adm-btn primary" type="submit">Enregistrer</button><span class="adm-flash" role="status" data-flash hidden></span></div>
    </form>
    <section class="panel adm-stack">
      <h2 class="adm-h2">Journal d’activité</h2>
      <ul class="dw-hist audit" data-audit></ul>
    </section>
  </div>
</div>
</Admin>
