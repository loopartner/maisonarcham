---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en'; mode: 'confirm' | 'unsubscribe' }
const { lang, mode } = Astro.props;
const t = useT(lang);
---
<Site lang={lang} route={mode === 'confirm' ? 'nlConfirm' : 'nlUnsub'} title={mode === 'confirm' ? t('nll.confirmTitle') : t('nll.unsubTitle')} noindex scripts={['newsletter-lien.js']}>
<section class="center-page"><div class="center-stack" data-nl-link={mode}>
  <h1 class="h1-s" data-title>{mode === 'confirm' ? t('nll.confirming') : t('nll.unsubTitle')}</h1>
  <p class="lead" data-msg role="status">{mode === 'unsubscribe' ? t('nll.unsubText') : ''}</p>
  {mode === 'unsubscribe' && <button class="btn" type="button" data-confirm>{t('nll.unsubBtn')}</button>}
  <a class="btn ghost" href={path(lang, 'home')} data-cta hidden>{t('nll.home')}</a>
</div></section>
</Site>
