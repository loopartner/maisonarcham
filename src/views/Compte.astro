---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
import { getMainProduct, loc } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const main = await getMainProduct();
const name = loc(main, 'name', lang), img = (main.images || [])[0];
const countries = lang === 'en' ? [['FR', 'France'], ['BE', 'Belgium'], ['LU', 'Luxembourg'], ['MC', 'Monaco'], ['CH', 'Switzerland']] : [['FR', 'France'], ['BE', 'Belgique'], ['LU', 'Luxembourg'], ['MC', 'Monaco'], ['CH', 'Suisse']];
---
<Site lang={lang} route="compte" title={t('nav.account')} noindex scripts={['compte.js']}>
<div class="acct">
  <p class="eyebrow muted">{t('acct.eyebrow')}</p>
  <h1 class="acct-h" data-greeting>{t('nav.account')}</h1>
  <p class="note info" data-welcome hidden role="status">{t('acct.welcome')}</p>
  <div class="note info acct-verify" data-verify hidden>
    <span>{t('acct.verify')}</span>
    <button class="txt-btn" type="button" data-resend>{t('acct.resend')}</button>
  </div>
  <div class="acct-layout">
    <nav class="acct-nav" aria-label={t('nav.account')}>
      <a href="#tableau-de-bord" data-tab="tableau-de-bord">{t('acct.dashboard')}</a>
      <a href="#commandes" data-tab="commandes">{t('acct.orders')}</a>
      <a href="#informations" data-tab="informations">{t('acct.info')}</a>
      <a href="#adresses" data-tab="adresses">{t('acct.addresses')}</a>
      <button type="button" data-logout>{t('acct.logout')}</button>
    </nav>
    <div class="acct-main">
      <p class="loading" data-loading>{t('acct.loading')}</p>

      <section data-panel="tableau-de-bord" hidden aria-label="Tableau de bord">
        <div class="card acct-current" data-current hidden>
          <div class="acct-row"><p class="eyebrow muted" data-cur-title></p><span class="acct-small muted" data-cur-date></span></div>
          <div class="acct-cur-item"><div class="acct-thumb"><img src={img} alt="" width="80" height="100"></div><div><p class="serif acct-cur-name" data-cur-name></p><p class="acct-small muted" data-cur-status></p></div></div>
          <ol class="track" data-cur-track></ol>
          <a class="btn ghost self-start" data-cur-link href="#">{t('acct.track')}</a>
        </div>
        <div class="card acct-empty" data-no-current hidden>
          <p class="serif acct-cur-name">{t('acct.noCurrent')}</p>
          <a class="link-ed self-start" href={path(lang, 'parfum')}>{t('cart.discover', { name })}</a>
        </div>
        <div class="acct-stats">
          <div class="card"><p class="eyebrow muted">{t('acct.ordersStat')}</p><p class="serif acct-stat" data-stat-orders>0</p></div>
          <div class="card"><p class="eyebrow muted">{t('acct.since')}</p><p class="serif acct-stat" data-stat-since></p></div>
          <div class="card"><p class="eyebrow muted">{t('nav.newsletter')}</p><p class="serif acct-stat" data-stat-nl></p><button class="txt-btn" type="button" data-nl-toggle></button></div>
        </div>
      </section>

      <section data-panel="commandes" hidden aria-labelledby="h-orders">
        <h2 class="acct-h2" id="h-orders">{t('acct.history')}</h2>
        <div class="acct-table-wrap">
          <table class="acct-table">
            <thead><tr><th scope="col">{t('acct.colOrder')}</th><th scope="col">{t('acct.colDate')}</th><th scope="col">{t('acct.colStatus')}</th><th scope="col">{t('js.total')}</th><th scope="col"><span class="sr-only">{t('js.details')}</span></th></tr></thead>
            <tbody data-orders></tbody>
          </table>
        </div>
        <p class="lead" data-orders-empty hidden>{t('acct.noOrders')}</p>
      </section>

      <section data-panel="informations" hidden aria-labelledby="h-info" class="acct-stack">
        <form class="card acct-form" data-profile novalidate>
          <h2 class="acct-h2" id="h-info">{t('acct.info')}</h2>
          <div class="acct-grid">
            <label class="field">{t('form.first')}<input class="in" name="firstName" autocomplete="given-name" maxlength="60" required><span class="field-err" data-fe="firstName" hidden></span></label>
            <label class="field">{t('form.last')}<input class="in" name="lastName" autocomplete="family-name" maxlength="60" required><span class="field-err" data-fe="lastName" hidden></span></label>
            <label class="field">{t('ck.phone')}<input class="in" name="phone" type="tel" autocomplete="tel" maxlength="30"><span class="field-err" data-fe="phone" hidden></span></label>
            <label class="field">{t('acct.birth')}<span class="muted">{t('form.optional')}</span><input class="in" name="birthDate" type="date" autocomplete="bday"><span class="field-err" data-fe="birthDate" hidden></span></label>
          </div>
          <div class="acct-actions"><button class="btn" type="submit">{t('acct.saveChanges')}</button><span class="acct-ok" role="status" data-ok hidden>{t('acct.saved')}</span></div>
        </form>

        <form class="card acct-form" data-email novalidate>
          <h2 class="acct-h3">{t('form.email')}</h2>
          <div class="acct-grid">
            <label class="field">{t('acct.newEmail')}<input class="in" name="email" type="email" autocomplete="email" maxlength="254" required><span class="field-err" data-fe="email" hidden></span></label>
            <label class="field">{t('acct.currentPwd')}<input class="in" name="password" type="password" autocomplete="current-password" maxlength="128" required><span class="field-err" data-fe="password" hidden></span></label>
          </div>
          <div class="acct-actions"><button class="btn ghost" type="submit">{t('acct.changeEmail')}</button><span class="acct-ok" role="status" data-ok hidden>{t('acct.emailChanged')}</span></div>
        </form>

        <form class="card acct-form" data-password novalidate>
          <h2 class="acct-h3">{t('auth.password')}</h2>
          <div class="acct-grid">
            <label class="field">{t('acct.currentPwd')}<input class="in" name="current" type="password" autocomplete="current-password" maxlength="128" required><span class="field-err" data-fe="current" hidden></span></label>
            <label class="field">{t('reset.new')}<input class="in" name="password" type="password" autocomplete="new-password" maxlength="128" required aria-describedby="pw-hint"><span class="hint" id="pw-hint">{t('js.pwdRule')}</span><span class="field-err" data-fe="password" hidden></span></label>
          </div>
          <div class="acct-actions"><button class="btn ghost" type="submit">{t('acct.changePwd')}</button><span class="acct-ok" role="status" data-ok hidden>{t('acct.pwdChanged')}</span></div>
        </form>

        <details class="card acct-danger">
          <summary>{t('acct.deleteTitle')}</summary>
          <form class="acct-form" data-delete novalidate>
            <p class="acct-small">{t('acct.deleteText')}</p>
            <label class="field">{t('auth.password')}<input class="in" name="password" type="password" autocomplete="current-password" maxlength="128" required><span class="field-err" data-fe="password" hidden></span></label>
            <button class="btn ghost danger self-start" type="submit">{t('acct.deleteBtn')}</button>
          </form>
        </details>
      </section>

      <section data-panel="adresses" hidden aria-labelledby="h-addr">
        <div class="acct-row acct-row-h"><h2 class="acct-h2" id="h-addr">{t('acct.addresses')}</h2><button class="btn ghost" type="button" data-addr-new>{t('acct.addAddr')}</button></div>
        <form class="card acct-form acct-addr-form" data-addr-form novalidate hidden>
          <h3 class="acct-h3" data-addr-title>{t('js.newAddr')}</h3>
          <input type="hidden" name="id">
          <div class="acct-grid">
            <label class="field">{t('acct.addrLabel')}<input class="in" name="label" maxlength="40" placeholder={t('acct.addrLabelPh')}></label>
            <label class="field">{t('ck.phone')}<span class="muted">{t('form.optional')}</span><input class="in" name="phone" type="tel" autocomplete="tel" maxlength="30"><span class="field-err" data-fe="phone" hidden></span></label>
            <label class="field">{t('form.first')}<input class="in" name="firstName" autocomplete="given-name" maxlength="60"><span class="field-err" data-fe="firstName" hidden></span></label>
            <label class="field">{t('form.last')}<input class="in" name="lastName" autocomplete="family-name" maxlength="60"><span class="field-err" data-fe="lastName" hidden></span></label>
            <label class="field full">{t('form.address')}<input class="in" name="line1" autocomplete="address-line1" maxlength="120"><span class="field-err" data-fe="line1" hidden></span></label>
            <label class="field full">{t('acct.addr2')}<span class="muted">{t('form.optional')}</span><input class="in" name="line2" autocomplete="address-line2" maxlength="120"></label>
            <label class="field">{t('form.postal')}<input class="in" name="postalCode" autocomplete="postal-code" maxlength="12"><span class="field-err" data-fe="postalCode" hidden></span></label>
            <label class="field">{t('form.city')}<input class="in" name="city" autocomplete="address-level2" maxlength="80"><span class="field-err" data-fe="city" hidden></span></label>
            <label class="field">{t('form.country')}<select class="in" name="country">{countries.map(([c, n]) => <option value={c}>{n}</option>)}</select><span class="field-err" data-fe="country" hidden></span></label>
          </div>
          <label class="check"><input type="checkbox" name="isDefault"><span>{t('acct.useDefault')}</span></label>
          <p class="field-err" role="alert" data-error hidden></p>
          <div class="acct-actions"><button class="btn" type="submit">{t('acct.saveAddr')}</button><button class="txt-btn" type="button" data-addr-cancel>{t('acct.cancel')}</button></div>
        </form>
        <div class="acct-addrs" data-addrs></div>
        <p class="lead" data-addrs-empty hidden>{t('acct.noAddr')}</p>
      </section>
    </div>
  </div>
</div>
</Site>
