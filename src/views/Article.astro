---
import Site from '../layouts/Site.astro';
import Img from '../components/Img.astro';
import JournalCard from '../components/JournalCard.astro';
import { useT, path, fmtDate, fmtEuros, LOCALES } from '../i18n/index.js';
import { getArticles, getMainProduct, variantOf, loc, rich } from '../lib/data.js';
interface Props { lang: 'fr' | 'en'; a: any }
const { lang, a } = Astro.props;
const t = useT(lang);
const title = loc(a, 'title', lang);
const body = (lang === 'en' ? a.bodyEn : a.body) || [];
const minutes = Math.max(1, Math.round(body.reduce((n, b) => n + (b.x ? b.x.split(/\s+/).length : 0), 0) / 200));
const related = (await getArticles(lang)).filter((x) => x.slug !== a.slug).slice(0, 3);
const p = await getMainProduct();
const variant = variantOf(lang === 'en' ? { ...p, kind: p.kindEn || p.kind } : p);
// Version de l'article dans l'autre langue (si elle existe)
const alternates = Object.fromEntries(LOCALES.filter((l) => l === 'fr' || (a.titleEn && a.bodyEn)).map((l) => [l, path(l, 'journal', a.slug)]));
alternates.en ||= path('en', 'journal');
---
<Site lang={lang} nav="journal" title={title.replace(/<\/?em>/g, '')} description={loc(a, 'excerpt', lang)} alternates={alternates}>
<article class="art">
  <header class="a-head">
    <a class="eyebrow muted a-back" href={path(lang, 'journal')}>← {t('home.journal')} · {loc(a, 'category', lang)}</a>
    <h1 class="a-title" set:html={rich(title)} />
    <p class="a-meta"><time datetime={a.date}>{fmtDate(lang, a.date)}</time> · {t('art.byHouse')} · {t('art.minutes', { n: minutes })}</p>
  </header>
  <figure class="a-hero zoom">
    <Img src={a.image} alt={loc(a, 'imageAlt', lang)} sizes="100vw" widths={[800, 1200, 1600, 2000]} priority />
    {loc(a, 'caption', lang) && <figcaption>{loc(a, 'caption', lang)}</figcaption>}
  </figure>
  <div class="a-body">
    {body.map((b) => {
      if (b.t === 'lead') return <p class="a-lead serif">{b.x}</p>;
      if (b.t === 'h2') return <h2 class="a-h2">{b.x}</h2>;
      if (b.t === 'quote') return <blockquote class="a-quote reveal"><p class="serif">{b.x}</p>{b.by && <footer class="eyebrow muted">{b.by}</footer>}</blockquote>;
      if (b.t === 'gallery') return (a.gallery || []).length ? <div class="a-gallery">{a.gallery.map((g) => <figure class="zoom reveal"><Img src={g.src} alt={g.alt || ''} sizes="(max-width: 700px) 100vw, 50vw" /></figure>)}</div> : null;
      return <p>{b.x}</p>;
    })}
  </div>
</article>
<aside class="a-product reveal">
  <div class="a-product-in">
    <div class="a-product-img"><Img src={(p.images || [])[0]} sizes="280px" widths={[400, 600]} /></div>
    <div class="a-product-text">
      <p class="eyebrow nl-sand">{t('art.productEyebrow')}</p>
      <p class="serif a-product-name">{loc(p, 'name', lang)}</p>
      <p class="nl-sand a-product-meta">{variant} · {fmtEuros(lang, p.price)}</p>
      <a class="btn on-dark self-start" href={path(lang, 'parfum')}>{t('home.discover')}</a>
    </div>
  </div>
</aside>
{related.length > 0 && <section class="band-white"><div class="wrap a-related"><h2 class="a-related-h">{t('art.related')}</h2><div class="j-grid">{related.map((x) => <JournalCard lang={lang} a={x} variant="related" />)}</div></div></section>}
</Site>
