---
import Checkout from '../layouts/Checkout.astro';
import { useT, path } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
---
<Checkout lang={lang} route="commande" title={t('ck.title')} noindex scripts={['commande.js']}>
<button class="ck-sum-toggle" type="button" aria-expanded="false" aria-controls="ck-sum" data-sum-toggle><span data-sum-label>{t('js.sumShow')}</span><span data-total></span></button>
<div class="ck">
  <form class="ck-main" data-checkout novalidate>
    <div class="ck-intro">
      <h1 class="ck-h">{t('ck.title')}</h1>
      <ol class="ck-steps eyebrow"><li data-step-dot="1" aria-current="step">01 {t('ck.s1')}</li><li data-step-dot="2">02 {t('ck.s2')}</li><li data-step-dot="3">03 {t('ck.s3')}</li></ol>
    </div>
    <p class="note error" role="alert" data-error hidden></p>
    <section class="sec" aria-labelledby="s1" data-step="1">
      <h2 id="s1" class="eyebrow">01 — {t('ck.s1Title')}</h2>
      <p class="hint" data-login-hint>{t('ck.already')} <a href={`${path(lang, 'connexion')}?suite=${encodeURIComponent(path(lang, 'commande'))}`}>{t('ck.signin')}</a> {t('ck.alreadyEnd')}</p>
      <div class="ck-grid">
        <label class="field">{t('form.email')}<input class="in" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required><span class="field-err" data-fe="email" hidden></span></label>
        <label class="field">{t('ck.phone')} <span class="muted">{t('ck.phoneHint')}</span><input class="in" name="phone" type="tel" autocomplete="tel" maxlength="30"><span class="field-err" data-fe="phone" hidden></span></label>
        <label class="field">{t('form.first')}<input class="in" name="firstName" autocomplete="given-name" maxlength="60" required><span class="field-err" data-fe="firstName" hidden></span></label>
        <label class="field">{t('form.last')}<input class="in" name="lastName" autocomplete="family-name" maxlength="60" required><span class="field-err" data-fe="lastName" hidden></span></label>
        <label class="field full">{t('form.address')}<input class="in" name="line1" autocomplete="shipping address-line1" maxlength="120" required><span class="field-err" data-fe="line1" hidden></span></label>
        <label class="field full">{t('form.address2')} <span class="muted">{t('form.optional')}</span><input class="in" name="line2" autocomplete="shipping address-line2" maxlength="120"></label>
        <label class="field">{t('form.postal')}<input class="in" name="postalCode" autocomplete="shipping postal-code" maxlength="12" required><span class="field-err" data-fe="postalCode" hidden></span></label>
        <label class="field">{t('form.city')}<input class="in" name="city" autocomplete="shipping address-level2" maxlength="80" required><span class="field-err" data-fe="city" hidden></span></label>
        <label class="field full">{t('form.country')}<select class="in" name="country" autocomplete="shipping country" data-countries><option value="FR">France</option></select><span class="field-err" data-fe="country" hidden></span></label>
      </div>
      <label class="check"><input type="checkbox" name="sameBilling" checked><span>{t('ck.sameBilling')}</span></label>
      <div class="ck-grid ck-billing" data-billing hidden>
        <label class="field full">{t('ck.billing')}<input class="in" name="b_line1" autocomplete="billing address-line1" maxlength="120"><span class="field-err" data-fe="billing.line1" hidden></span></label>
        <label class="field">{t('form.postal')}<input class="in" name="b_postalCode" autocomplete="billing postal-code" maxlength="12"><span class="field-err" data-fe="billing.postalCode" hidden></span></label>
        <label class="field">{t('form.city')}<input class="in" name="b_city" autocomplete="billing address-level2" maxlength="80"><span class="field-err" data-fe="billing.city" hidden></span></label>
        <label class="field full">{t('form.country')}<select class="in" name="b_country" autocomplete="billing country" data-countries><option value="FR">France</option></select><span class="field-err" data-fe="billing.country" hidden></span></label>
      </div>
      <button class="btn block ck-next" type="button" data-go-step="2">{t('ck.toShipping')}</button>
    </section>
    <section class="sec" aria-labelledby="s2" data-step="2">
      <h2 id="s2" class="eyebrow">02 — {t('ck.s2Title')}</h2>
      <div class="ck-ships" data-ships role="radiogroup" aria-labelledby="s2"></div>
      <button class="btn block ck-next" type="button" data-go-step="3">{t('ck.toPayment')}</button>
      <button class="txt-btn ck-next" type="button" data-go-step="1">← {t('ck.editDetails')}</button>
    </section>
    <section class="sec" aria-labelledby="s3" data-step="3">
      <h2 id="s3" class="eyebrow">03 — {t('ck.s3')}</h2>
      <div class="ck-pay" data-pay><p>{t('ck.payText')}</p></div>
      <label class="check"><input type="checkbox" name="acceptTerms"><span>{t('ck.acceptA')} <a href={path(lang, 'cgv')}>{t('ck.terms')}</a> {t('ck.and')} <a href={path(lang, 'confidentialite')}>{t('ck.privacy')}</a>.</span></label>
      <p class="field-err" data-fe="acceptTerms" hidden></p>
      <button class="btn block" type="submit" data-submit>{t('ck.pay')} — <span data-total></span></button>
      <p class="note info" role="status" data-pay-later hidden>{t('ck.payLater')}</p>
    </section>
  </form>
  <aside class="ck-sum" id="ck-sum" aria-labelledby="ck-sum-t">
    <p class="eyebrow" id="ck-sum-t">{t('cart.summary')}</p>
    <ul class="ck-lines" data-lines></ul>
    <div class="ck-promo"><label class="sr-only" for="ck-promo">{t('cart.promo')}</label><input id="ck-promo" class="in" placeholder={t('cart.promo')} autocomplete="off" maxlength="32" data-code><button class="btn ghost" type="button" data-apply>OK</button></div>
    <p class="promo-msg" role="status" data-promo-msg hidden></p>
    <div class="sum-row"><span>{t('cart.subtotal')}</span><span data-subtotal></span></div>
    <div class="sum-row" data-discount-row hidden><span data-discount-label></span><span data-discount></span></div>
    <div class="sum-row"><span>{t('cart.shipping')}</span><span data-ship-price></span></div>
    <div class="sum-total"><span class="eyebrow">{t('cart.totalTtc')}</span><span class="serif" data-total></span></div>
    <p class="sum-note">{t('ck.note')}</p>
  </aside>
</div>
</Checkout>
