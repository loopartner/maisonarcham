---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
import { getSite } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const email = (await getSite()).company.email || 'contact@maison-archam.fr';
const faq = [1, 2, 3, 4, 5, 6];
---
<Site lang={lang} route="aide" title={t('help.title')} description={t('help.description')} scripts={['aide.js']}>
<section class="page-head"><p class="eyebrow muted">{t('ft.service')}</p><h1 class="h1">{t('help.title')}</h1><p class="lead help-lead">{t('help.lead')}</p></section>
<div class="help">
  <ul class="help-keys" id="livraison">
    <li class="reveal"><p class="serif">{t('help.k1')}</p><p>{t('help.k1d')}</p></li>
    <li class="reveal"><p class="serif">{t('pdp.r2')}</p><p>{t('help.k2d')}</p></li>
    <li class="reveal"><p class="serif">{t('pdp.r3')}</p><p>{t('help.k3d')} <a href={path(lang, 'cgv')}>{t('ck.terms')}</a>.</p></li>
  </ul>
  <section class="help-faq" id="faq" aria-labelledby="faq-h">
    <h2 class="m-h2" id="faq-h">{t('help.faq')}</h2>
    <div class="acc-group">{faq.map((i) => <details class="acc" name="faq"><summary>{t(`help.q${i}`)}<span aria-hidden="true"></span></summary><p set:html={t(`help.a${i}`, { account: path(lang, 'compte') })} /></details>)}</div>
  </section>
  <section class="help-contact" id="contact" aria-labelledby="contact-h">
    <div class="help-contact-intro"><h2 class="m-h2" id="contact-h">{t('help.contact')}</h2><p class="body-m">{t('help.contactText')}</p><p class="body-m"><a href={`mailto:${email}`}>{email}</a></p></div>
    <div class="help-form-wrap">
      <p class="note info" role="status" tabindex="-1" data-sent hidden>{t('help.sent')}</p>
      <form class="form help-form" data-contact novalidate>
        <div class="grid-2"><label class="field">{t('help.name')}<input class="in" name="name" autocomplete="name" maxlength="120" required></label><label class="field">{t('form.email')}<input class="in" name="email" type="email" autocomplete="email" maxlength="254" required></label></div>
        <label class="field">{t('help.subject')}<select class="in" name="subject">{['s1', 's2', 's3', 's4', 's5'].map((k) => <option>{t(`help.${k}`)}</option>)}</select></label>
        <label class="field">{t('help.message')}<textarea class="in help-msg" name="message" rows="6" maxlength="5000" required></textarea></label>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <p class="field-err" role="alert" data-error hidden></p>
        <button class="btn self-start" type="submit">{t('help.send')}</button>
      </form>
    </div>
  </section>
</div>
</Site>
