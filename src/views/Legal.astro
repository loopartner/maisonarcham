---
import Site from '../layouts/Site.astro';
import { useT } from '../i18n/index.js';
import { LEGAL } from '../i18n/legal.js';
import { getSite } from '../lib/data.js';
interface Props { lang: 'fr' | 'en'; doc: 'cgv' | 'confidentialite' | 'mentions' }
const { lang, doc } = Astro.props;
const t = useT(lang);
const d = LEGAL[doc][lang];
const c = (await getSite()).company;
const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (x) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[x]));
const todo = lang === 'en' ? 'to be completed' : 'à compléter';
const fill = (s) => esc(s)
  .replace(/\{company\.(\w+)\}/g, (_, k) => (c[k] ? esc(c[k]) : `<mark>${k === 'name' ? 'Maison Archam' : todo}</mark>`))
  .replace(/\[\[(.+?)\]\]/g, '<mark>$1</mark>');
const hasTodo = d.sections.some(([, x]) => x.includes('[[')) || ['address', 'siret', 'vat', 'phone'].some((k) => !c[k]);
---
<Site lang={lang} route={doc} title={d.title}>
<section class="page-head"><p class="eyebrow muted">{t('legal.eyebrow')}</p><h1 class="h1">{d.title}</h1></section>
<div class="prose">
  {hasTodo && <p class="note info">{t('legal.draft')}</p>}
  {d.sections.map(([h, p]) => <><h2>{h}</h2><p set:html={fill(p)} /></>)}
</div>
</Site>
