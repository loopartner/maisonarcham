---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
---
<Site lang={lang} route="confirmation" title={t('conf.title')} noindex scripts={['confirmation.js']}>
<div class="conf">
  <div class="conf-head">
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="23" stroke="currentColor"/><path d="M15 24.5l6.5 6.5L34 18" stroke="currentColor" stroke-width="1.4"/></svg>
    <p class="eyebrow muted" data-c-number hidden></p>
    <h1 class="conf-h" data-c-title>{t('conf.title')}</h1>
    <p class="body-l conf-lead" data-c-lead role="status">{t('conf.loading')}</p>
  </div>
  <div class="conf-grid" data-c-details hidden>
    <div class="panel conf-card">
      <p class="eyebrow muted">{t('cart.summary')}</p>
      <ul class="conf-items" data-c-items></ul>
      <div class="sum-row conf-sep"><span data-c-ship-label>{t('cart.shipping')}</span><span data-c-ship></span></div>
      <div class="sum-row" data-c-disc-row hidden><span>{t('conf.discount')}</span><span data-c-disc></span></div>
      <div class="conf-total"><span class="eyebrow">{t('js.total')}</span><span class="serif" data-c-total></span></div>
    </div>
    <div class="panel conf-card"><p class="eyebrow muted">{t('conf.address')}</p><p class="conf-addr" data-c-address></p></div>
    <div class="conf-next">
      <p class="eyebrow">{t('conf.next')}</p>
      <ol><li><span class="serif">01</span><span>{t('conf.n1')}</span></li><li><span class="serif">02</span><span>{t('conf.n2')}</span></li><li><span class="serif">03</span><span>{t('conf.n3')}</span></li></ol>
    </div>
  </div>
  <div class="conf-actions"><a class="btn" href={path(lang, 'compte')}>{t('conf.track')}</a><a class="btn ghost" href={path(lang, 'journal')}>{t('conf.read')}</a></div>
</div>
</Site>
