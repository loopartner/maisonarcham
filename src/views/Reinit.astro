---
import Site from '../layouts/Site.astro';
import PwdToggle from '../components/PwdToggle.astro';
import { useT } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
---
<Site lang={lang} route="reinit" title={t('reset.title')} noindex scripts={['reinitialiser.js']}>
<section class="center-page">
  <form class="form" data-form="reset" novalidate>
    <h1 class="h1-s">{t('reset.title')}</h1>
    <p class="lead">{t('reset.lead')}</p>
    <div class="field"><label for="rs-password">{t('reset.new')}</label><div class="pwd-wrap"><input class="in" id="rs-password" name="password" type="password" autocomplete="new-password" maxlength="128" required aria-describedby="rs-hint"><PwdToggle id="rs-password" label={t('js.showPwd')} /></div><span class="hint" id="rs-hint" data-pwd-hint aria-live="polite">{t('js.pwdRule')}</span></div>
    <label class="field" for="rs-confirm">{t('reset.confirm')}<input class="in" id="rs-confirm" name="confirm" type="password" autocomplete="new-password" maxlength="128" required></label>
    <p class="field-err" role="alert" data-error hidden></p>
    <button class="btn" type="submit">{t('reset.save')}</button>
  </form>
</section>
</Site>
