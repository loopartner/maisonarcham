---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
import { getMainProduct, loc } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const name = loc(await getMainProduct(), 'name', lang);
---
<Site lang={lang} route="panier" title={t('cart.title')} noindex scripts={['panier.js']}>
<div class="cart-page">
  <h1 class="cart-h">{t('cart.title')}</h1>
  <div class="cart-empty" data-page-empty hidden>
    <p class="eyebrow muted">{t('cart.emptyEyebrow')}</p>
    <p class="serif cart-empty-t" set:html={t('cart.emptyTitle')} />
    <p class="lead">{t('cart.emptyText', { name })}</p>
    <a class="btn" href={path(lang, 'parfum')}>{t('home.discover')}</a>
  </div>
  <div class="cart-layout" data-page-filled hidden>
    <div class="cart-main">
      <div class="cart-cols eyebrow muted" aria-hidden="true"><span>{t('cart.item')}</span><span>{t('pdp.qty')}</span><span>{t('js.total')}</span></div>
      <ul class="cart-list" data-page-lines aria-label={t('cart.items')}></ul>
      <a class="link-ed cart-back" href={path(lang, 'parfum')}>← {t('cart.continue')}</a>
    </div>
    <aside class="summary" aria-labelledby="sum-title">
      <p class="eyebrow" id="sum-title">{t('cart.summary')}</p>
      <div class="sum-row"><span>{t('cart.subtotal')}</span><span data-q-subtotal></span></div>
      <div class="sum-row" data-q-discount-row hidden><span data-q-discount-label></span><span data-q-discount></span></div>
      <fieldset class="ship"><legend>{t('cart.shipping')}</legend><div data-q-ships></div></fieldset>
      <form class="promo" data-promo novalidate>
        <label for="promo">{t('cart.promo')}</label>
        <div class="promo-row"><input id="promo" class="in" name="code" autocomplete="off" autocapitalize="characters" maxlength="32" placeholder={t('cart.promoPh')}><button class="btn ghost promo-btn" type="submit">{t('cart.apply')}</button></div>
        <p class="promo-msg" role="status" data-promo-msg hidden></p>
      </form>
      <div class="sum-total"><span class="eyebrow">{t('cart.totalTtc')}</span><span class="serif" data-q-total></span></div>
      <a class="btn" href={path(lang, 'commande')}>{t('cart.checkout')}</a>
      <p class="sum-note">{t('cart.note')}</p>
    </aside>
  </div>
</div>
<template id="tpl-page-line">
  <li class="cart-line">
    <div class="cl-item">
      <a class="cl-thumb" href={path(lang, 'parfum')} tabindex="-1" aria-hidden="true"><img alt="" width="120" height="150" data-l-img></a>
      <div class="cl-info"><p class="serif cl-name" data-l-name></p><p class="muted cl-variant" data-l-variant></p><p class="cl-unit" data-l-unit></p><button class="txt-btn cd-remove" type="button" data-l-remove>{t('cart.remove')}</button></div>
    </div>
    <div class="qty cl-qty"><button class="qbtn" type="button" data-l-dec>−</button><span class="qval" data-l-qty></span><button class="qbtn" type="button" data-l-inc>+</button></div>
    <span class="cl-total" data-l-total></span>
  </li>
</template>
</Site>
