---
import Site from '../layouts/Site.astro';
import { useT, path } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
---
<Site lang={lang} route="compteCommande" title={t('acct.orderDetail')} noindex scripts={['compte-commande.js']}>
<div class="acct">
  <a class="acct-back" href={`${path(lang, 'compte')}#commandes`}>← {t('acct.orders')}</a>
  <p class="lead" data-loading>{t('acct.loading')}</p>
  <p class="note error" data-error hidden></p>
  <div data-order hidden>
    <div class="acct-row od-head"><div><p class="eyebrow muted" data-o-date></p><h1 class="od-h" data-o-title></h1></div><span class="status" data-o-status></span></div>
    <section class="card od-track" aria-labelledby="h-track">
      <h2 class="eyebrow" id="h-track">{t('acct.tracking')}</h2>
      <ol class="track track-lg" data-o-track></ol>
      <div class="od-carrier" data-o-carrier hidden><span data-o-carrier-text></span><a data-o-tracking target="_blank" rel="noopener noreferrer" hidden>{t('acct.carrierLink')} ↗</a></div>
    </section>
    <div class="od-grid">
      <section class="card od-card" aria-labelledby="h-items">
        <h2 class="eyebrow" id="h-items">{t('cart.items')}</h2>
        <ul class="od-items" data-o-items></ul>
        <div class="od-sums">
          <div class="sum-row"><span>{t('cart.subtotal')}</span><span data-o-subtotal></span></div>
          <div class="sum-row" data-o-disc-row hidden><span>{t('conf.discount')}</span><span data-o-disc></span></div>
          <div class="sum-row"><span data-o-ship-label>{t('cart.shipping')}</span><span data-o-ship></span></div>
          <div class="sum-total"><span class="eyebrow">{t('cart.totalTtc')}</span><span class="serif" data-o-total></span></div>
        </div>
      </section>
      <section class="card od-card">
        <div><h2 class="eyebrow">{t('cart.shipping')}</h2><p class="od-addr" data-o-address></p></div>
        <div><h2 class="eyebrow">{t('ck.s3')}</h2><p class="od-addr" data-o-payment></p></div>
        <div class="od-actions"><a class="btn ghost" data-o-return href={`${path(lang, 'aide')}#contact`}>{t('acct.return')}</a></div>
      </section>
    </div>
  </div>
</div>
</Site>
