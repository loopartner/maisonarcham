---
import Site from '../layouts/Site.astro';
import Img from '../components/Img.astro';
import PwdToggle from '../components/PwdToggle.astro';
import { useT, path } from '../i18n/index.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
---
<Site lang={lang} route="connexion" title={t('auth.title')} description={t('auth.description')} noindex scripts={['connexion.js']}>
<div class="auth">
  <div class="auth-visual"><Img src="/assets/img/flacon-nuit.svg" width={1200} height={1500} /></div>
  <div class="auth-panel">
    <div class="tabs" role="tablist" aria-label={t('auth.tabs')}>
      <button class="tab" role="tab" type="button" id="tab-login" aria-controls="panel-login" aria-selected="true" data-tab="login">{t('auth.tabLogin')}</button>
      <button class="tab" role="tab" type="button" id="tab-signup" aria-controls="panel-signup" aria-selected="false" tabindex="-1" data-tab="signup">{t('auth.tabSignup')}</button>
    </div>
    <p class="note info" data-notice hidden role="status"></p>
    <section id="panel-login" role="tabpanel" aria-labelledby="tab-login" data-panel="login">
      <form class="form" data-form="login" novalidate>
        <h1 class="h1-s">{t('auth.welcome')}</h1>
        <label class="field" for="login-email">{t('form.email')}<input class="in" id="login-email" name="email" type="email" autocomplete="username" inputmode="email" maxlength="254" required></label>
        <div class="field"><label for="login-password">{t('auth.password')}</label><div class="pwd-wrap"><input class="in" id="login-password" name="password" type="password" autocomplete="current-password" maxlength="128" required><PwdToggle id="login-password" label={t('js.showPwd')} /></div></div>
        <p class="field-err" role="alert" data-error hidden></p>
        <button class="txt-btn" type="button" data-go="forgot">{t('auth.forgot')}</button>
        <button class="btn" type="submit">{t('auth.signin')}</button>
      </form>
    </section>
    <section id="panel-signup" role="tabpanel" aria-labelledby="tab-signup" data-panel="signup" hidden>
      <form class="form" data-form="signup" novalidate>
        <h1 class="h1-s">{t('auth.create')}</h1>
        <p class="lead">{t('auth.createLead')}</p>
        <div class="grid-2">
          <label class="field" for="su-first">{t('form.first')}<input class="in" id="su-first" name="firstName" autocomplete="given-name" maxlength="60" required><span class="field-err" data-field-error="firstName" hidden></span></label>
          <label class="field" for="su-last">{t('form.last')}<input class="in" id="su-last" name="lastName" autocomplete="family-name" maxlength="60" required><span class="field-err" data-field-error="lastName" hidden></span></label>
        </div>
        <label class="field" for="su-email">{t('form.email')}<input class="in" id="su-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required><span class="field-err" data-field-error="email" hidden></span></label>
        <div class="field">
          <label for="su-password">{t('auth.password')}</label>
          <div class="pwd-wrap"><input class="in" id="su-password" name="password" type="password" autocomplete="new-password" maxlength="128" required aria-describedby="su-pwd-hint"><PwdToggle id="su-password" label={t('js.showPwd')} /></div>
          <span class="hint" id="su-pwd-hint" data-pwd-hint aria-live="polite">{t('js.pwdRule')}</span>
          <span class="field-err" data-field-error="password" hidden></span>
        </div>
        <label class="check"><input type="checkbox" name="newsletter"><span>{t('auth.nl')}</span></label>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
        <p class="field-err" role="alert" data-error hidden></p>
        <button class="btn" type="submit">{t('auth.createBtn')}</button>
        <p class="hint">{t('auth.legalA')} <a href={path(lang, 'cgv')}>{t('ck.terms')}</a> {t('ck.and')} <a href={path(lang, 'confidentialite')}>{t('ck.privacy')}</a>.</p>
      </form>
    </section>
    <section data-panel="forgot" hidden>
      <form class="form" data-form="forgot" novalidate>
        <h1 class="h1-s">{t('auth.forgotTitle')}</h1>
        <p class="lead">{t('auth.forgotLead')}</p>
        <label class="field" for="fg-email">{t('form.email')}<input class="in" id="fg-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required></label>
        <p class="note info" role="status" data-sent hidden>{t('auth.forgotSent')}</p>
        <p class="field-err" role="alert" data-error hidden></p>
        <button class="btn" type="submit">{t('auth.forgotBtn')}</button>
        <button class="txt-btn" type="button" data-go="login">← {t('auth.back')}</button>
      </form>
    </section>
  </div>
</div>
</Site>
