---
import Site from '../layouts/Site.astro';
import Img from '../components/Img.astro';
import JournalCard from '../components/JournalCard.astro';
import { useT, path, fmtEuros } from '../i18n/index.js';
import { getProducts, getMainProduct, getArticles, variantOf, loc } from '../lib/data.js';
interface Props { lang: 'fr' | 'en' }
const { lang } = Astro.props;
const t = useT(lang);
const products = await getProducts();
const p = await getMainProduct();
const name = loc(p, 'name', lang);
const notes = lang === 'en' && p.notesEn ? p.notesEn : p.notes;
const vol = (x) => x.volume;
const articles = (await getArticles(lang)).slice(0, 3);
const images = (p.images || []).slice(0, 6);
const br = (arr) => arr.map((s) => String(s).replace(/[&<>]/g, '')).join('<br>');
---
<Site lang={lang} route="parfum" nav="parfum" title={`${name} — ${lang === 'en' ? p.kindEn || p.kind : p.kind}`} description={t('pdp.description', { name })} scripts={['parfum.js']}>
<nav class="crumb" aria-label={t('pdp.crumb')}><a href={path(lang, 'home')}>{t('nav.home')}</a> <span aria-hidden="true">/</span> <span aria-current="page">{t('nav.parfum')}</span></nav>

<section class="pdp">
  <div class="pdp-gallery">
    <div class="pdp-thumbs" role="group" aria-label={t('pdp.photos')}>
      {images.map((src, i) => (
        <button class="pdp-thumb" type="button" aria-pressed={String(i === 0)} aria-label={t('pdp.photo', { n: i + 1 })} data-img={src} data-alt={`${name} — ${t('pdp.photo', { n: i + 1 })}`}><img src={src} alt="" width="84" height="105" loading="lazy" decoding="async"></button>
      ))}
    </div>
    <div class="pdp-main zoom">
      <img src={images[0]} alt={`${name} — ${t('pdp.photo', { n: 1 })}`} width="1000" height="1250" data-main-img fetchpriority="high">
      <span class="eyebrow pdp-badge">{t('pdp.limited')}</span>
      <button class="pdp-nav prev" type="button" aria-label={t('pdp.prev')} data-img-prev></button>
      <button class="pdp-nav next" type="button" aria-label={t('pdp.next')} data-img-next></button>
      <div class="pdp-dots" aria-hidden="true" data-dots></div>
    </div>
  </div>

  <div class="pdp-info">
    <p class="eyebrow muted">Maison Archam — {lang === 'en' ? p.kindEn || p.kind : p.kind}</p>
    <h1 class="pdp-title">{name}</h1>
    <p class="serif pdp-tag">{loc(p, 'tagline', lang)}</p>
    <p class="serif t-price" data-price>{fmtEuros(lang, p.price)}</p>
    <p class="body-l">{loc(p, 'description', lang)}</p>
    <fieldset class="sizes">
      <legend class="eyebrow muted">{t('pdp.size')}</legend>
      <div class="sizes-row">
        {products.map((x) => <button class="size-opt" type="button" aria-pressed={String(x.id === p.id)} data-size={x.id} data-price={x.price}>{vol(x)} — {fmtEuros(lang, x.price)}</button>)}
      </div>
    </fieldset>
    <div class="buy-row">
      <div class="qty" role="group" aria-label={t('pdp.qty')}>
        <button class="qbtn" type="button" aria-label={t('pdp.qtyDec')} data-q-dec>−</button>
        <span class="qval" data-q aria-live="polite">1</span>
        <button class="qbtn" type="button" aria-label={t('pdp.qtyInc')} data-q-inc>+</button>
      </div>
      <button class="btn buy-btn" type="button" data-buy>{t('home.addToCart')} — <span data-line-total>{fmtEuros(lang, p.price)}</span></button>
    </div>
    <ul class="reassure"><li>{t('pdp.r1')}</li><li>{t('pdp.r2')}</li><li>{t('pdp.r3')}</li></ul>
    <div class="acc-group">
      <details class="acc" name="pdp" open><summary>{t('pdp.descTitle')}<span aria-hidden="true"></span></summary><p>{t('pdp.descText', { name })}</p></details>
      <details class="acc" name="pdp"><summary>{t('pdp.familyTitle')}<span aria-hidden="true"></span></summary><p>{t('home.family')} : {loc(p, 'family', lang)}<br>{t('pdp.sillage')} : {loc(p, 'sillage', lang)}</p></details>
      <details class="acc" name="pdp"><summary>{t('pdp.shipTitle')}<span aria-hidden="true"></span></summary><p set:html={t('pdp.shipText')} /></details>
    </div>
  </div>
</section>

<section class="band-white">
  <div class="wrap pad-140">
    <p class="eyebrow muted">{t('pdp.pyramid')}</p>
    <h2 class="t-xl pyr-h">{loc(p, 'family', lang)}</h2>
    <ol class="pyramid">
      <li class="reveal"><p class="eyebrow muted">{t('home.top')}</p><p class="serif pyr-notes" set:html={br(notes.top)} /><p class="pyr-text">{t('pdp.topText')}</p></li>
      <li class="reveal"><p class="eyebrow muted">{t('home.heart')}</p><p class="serif pyr-notes" set:html={br(notes.heart)} /><p class="pyr-text">{t('pdp.heartText')}</p></li>
      <li class="reveal"><p class="eyebrow muted">{t('home.base')}</p><p class="serif pyr-notes" set:html={br(notes.base)} /><p class="pyr-text">{t('home.baseText')}</p></li>
    </ol>
  </div>
</section>

<section class="wrap split">
  <div class="split-img zoom ratio-45 reveal"><Img src="/assets/img/atelier-mouillettes.svg" alt={t('pdp.atelierAlt')} width={1200} height={1500} /></div>
  <div class="split-text reveal">
    <p class="eyebrow muted">{t('pdp.craft')}</p>
    <h2 class="t-xl" set:html={t('pdp.craftTitle')} />
    <p class="body-l">{t('pdp.craftText')}</p>
    <ol class="steps"><li><span class="serif">01</span><span>{t('pdp.s1')}</span></li><li><span class="serif">02</span><span>{t('pdp.s2')}</span></li><li><span class="serif">03</span><span>{t('pdp.s3')}</span></li></ol>
  </div>
</section>

{articles.length > 0 && (
<section class="band-white">
  <div class="wrap pad-140">
    <div class="sec-head"><h2 class="t-xl">{t('pdp.read')}</h2><a class="link-ed" href={path(lang, 'journal')}>{t('home.journal')}</a></div>
    <div class="j-grid">{articles.map((a) => <JournalCard lang={lang} a={a} />)}</div>
  </div>
</section>
)}
<div class="m-buy" data-mbuy>
  <div class="qty" role="group" aria-label={t('pdp.qty')}>
    <button class="qbtn" type="button" aria-label={t('pdp.qtyDec')} data-q-dec>−</button>
    <span class="qval" data-q>1</span>
    <button class="qbtn" type="button" aria-label={t('pdp.qtyInc')} data-q-inc>+</button>
  </div>
  <button class="btn m-buy-btn" type="button" data-buy>{t('pdp.add')} · <span data-line-total>{fmtEuros(lang, p.price)}</span></button>
</div>
</Site>
